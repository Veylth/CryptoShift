# CryptoShift Configuration
# Copy this file to .env and update values as needed

# Environment
ENVIRONMENT=development
DEBUG_MODE=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database
# DATABASE_URL is auto-generated from config.py
# SQLite path: data/cryptoshift.db

# Logging
LOG_LEVEL=INFO

# CoinGecko API (public, no key needed)
# COIN_GECKO_API is set in config.py

# Feature Engineering
VOLATILITY_WINDOW=24
MOMENTUM_WINDOW=24
EWMA_ALPHA=0.3

# Anomaly Detection
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.05
EWMA_STD_THRESHOLD=2.0

# Backtesting
BACKTEST_TRAIN_MONTHS=3
BACKTEST_TEST_MONTHS=1

# Data Ingestion
POLLING_INTERVAL=60

# Optional: Slack/Email notifications (for future use)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_EMAIL=alerts@example.com
